# ANALIZADOR IR - UNCP - Yauri Navarro - EDITABLE
import math, numpy as np, matplotlib.pyplot as plt

# ===== CAMBIA AQUI TUS DATOS =====
wn = 1715  # Numero de onda que te pidan (cm-1)
dm = np.array([0.8, 0.5, 0.3]) # Tu Delta mu (x,y,z) *1e-30
ed = np.array([1, 0.2, 0.1]) # Tu vector e
# =================================

C=299792458.0
H=6.62607015e-34
NA=6.02214076e23

dm_SI = dm*1e-30
ed_norm = ed/np.linalg.norm(ed)
prod = np.dot(dm_SI, ed_norm)
mag = np.linalg.norm(dm_SI)
ang = math.degrees(math.acos(prod/mag))

wm=wn*100
f=C*wm
lam=1/wm
E=(H*f*NA)/1000

print(f"===== RESULTADOS PARA {wn} cm-1 =====")
print(f"1715 cm-1 ejemplo = 20.516 kJ/mol")
print(f"Delta magnitude {mag:.3e} C·m")
print(f"Delta·e {prod:.3e} C·m")
print(f"Angulo entre Delta y e: {ang:.2f}°")
print(f"Frecuencia: {f/1e12:.2f} THz")
print(f"Longitud onda: {lam*1e6:.3f} um")
print(f"Energia: {E:.3f} kJ/mol")

# Imagen
x=np.linspace(4000,400,1000)
g=lambda x,mu,s,a: a*np.exp(-0.5*((x-mu)/s)**2)
# Si cambias wn, el pico se mueve automatico
y=g(x,wn,20,1)+g(x,2950,30,0.6)+g(x,3300,40,0.4)

plt.figure(figsize=(9,4))
plt.plot(x,y,color='darkred',lw=2)
plt.axvline(wn,color='blue',linestyle='--',label=f'{wn} cm-1')
plt.gca().invert_xaxis()
plt.title(f"Espectro IR UNCP - Pico {wn} cm-1 - {E:.2f} kJ/mol")
plt.xlabel("Numero de onda cm-1")
plt.ylabel("Absorbancia")
plt.legend()
plt.grid(True,alpha=0.3)
plt.show()
